# Which brain INJI uses: anthropic | gemini | claude-code
# anthropic   — Anthropic API key with credits (best quality, deployable)
# gemini      — Google Gemini free tier (deployable; get a key at aistudio.google.com/apikey)
# claude-code — local Claude Code subscription via the Agent SDK (dev only, not deployable)
# Omit to auto-pick: anthropic key → gemini key → claude-code.
INJI_BRAIN=

# Anthropic — used when INJI_BRAIN=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Gemini — used when INJI_BRAIN=gemini
GEMINI_API_KEY=

# Injective network: mainnet | testnet
NEXT_PUBLIC_INJECTIVE_NETWORK=mainnet

# Optional
COINGECKO_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
