# Which brain INJI uses: nvidia | groq | gemini | anthropic | minimax | claude-code
# nvidia      — NVIDIA NIM free endpoint (Qwen 3.5 122B — recommended; build.nvidia.com)
# groq        — Groq free tier (fast, but 6k tokens/min cap; console.groq.com)
# gemini      — Google Gemini free tier (aistudio.google.com/apikey)
# anthropic   — Anthropic API key with credits (best quality)
# minimax     — MiniMax-M3 via any OpenAI-compatible router
# claude-code — local Claude Code subscription via the Agent SDK (dev only, not deployable)
# Omit to auto-pick: anthropic → gemini → groq → minimax → nvidia → claude-code.
INJI_BRAIN=nvidia

# NVIDIA NIM — used when INJI_BRAIN=nvidia (free key at build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=qwen/qwen3.5-122b-a10b

# Groq — used when INJI_BRAIN=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — used when INJI_BRAIN=anthropic
ANTHROPIC_API_KEY=

# Gemini — used when INJI_BRAIN=gemini
GEMINI_API_KEY=

# MiniMax — used when INJI_BRAIN=minimax (OpenAI-compatible endpoint)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# Injective network: mainnet | testnet
NEXT_PUBLIC_INJECTIVE_NETWORK=mainnet

# Optional
COINGECKO_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
